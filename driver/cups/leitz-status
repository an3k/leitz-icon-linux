#!/usr/bin/env bash
# Leitz Icon independent USB status. Only ESC U; never prints or cuts.
# Use when idle; Linux usblp rejects concurrent opens of /dev/usb/lpN.
set -euo pipefail
LC_ALL=C
DEVICE=${LEITZ_DEVICE:-/dev/usb/lp0}
# An alternative basename alone must not allow opening an arbitrary device.
if [[ ! "$DEVICE" =~ ^/dev/usb/lp[0-9]+$ || -L "$DEVICE" ]]; then
  echo 'ERROR: LEITZ_DEVICE must be a direct /dev/usb/lpN character device' >&2
  exit 4
fi
if [[ $# != 0 && ( $# != 2 || $1 != --expected-sku ) ]]; then
  echo 'Usage: leitz-status [--expected-sku NNNNNNNN]' >&2; exit 2
fi
if [[ $# == 2 && ! $2 =~ ^[0-9]{8}$ ]]; then
  echo 'ERROR: Expected an eight-digit SKU' >&2; exit 2
fi
[[ -c "$DEVICE" ]] || { echo 'STATE=USB_DEVICE_MISSING';exit 4; }
base=$(basename "$DEVICE")
[[ "$base" =~ ^lp[0-9]+$ ]] || { echo 'ERROR: Unsupported USB device path' >&2;exit 4; }
root=$(readlink -f "/sys/class/usbmisc/$base/device") || exit 4
root=${root%/*}
read -r vid < "$root/idVendor" || exit 4
read -r pid < "$root/idProduct" || exit 4
if [[ "${vid,,}" != 289e || "${pid,,}" != 1000 ]];then
  echo "ERROR: USB device not Leitz Icon ($vid:$pid)" >&2;exit 4
fi
exec 3<>"$DEVICE" || { echo 'STATE=USB_BUSY_OR_UNAVAILABLE'; exit 4; }
printf '\033U' >&3 || exit 4
# ESC U responses need not include a NUL terminator. The timed read
# can return a complete partial buffer; accept only the exact forms
# below and never interpret arbitrary partial data as a cartridge.
response=''
IFS= read -r -d '' -n 1024 -t 5 response <&3 || :
exec 3>&-
if [[ -z "$response" ]]; then
  echo 'STATE=NO_REPLY';exit 4
fi
if [[ "$response" == 'SKU:No Cartridge;;;' ]];then
  echo "RAW=$response"
  echo 'STATE=NO_CARTRIDGE';exit 4
fi
if [[ "$response" =~ ^SKU:([0-9]{8})\;INIT:([0-9]+)\;USED:([0-9]+)\;$ ]];then
  sku=${BASH_REMATCH[1]}; init=${BASH_REMATCH[2]}; used=${BASH_REMATCH[3]}
  echo "RAW=$response"
else
  echo 'STATE=UNRECOGNIZED';exit 4
fi
printf 'STATE=CARTRIDGE_DETECTED\nSKU=%s\nINIT_RAW=%s\nUSED_RAW=%s\n' "$sku" "$init" "$used"
case "$sku" in
  70030001) echo 'MATERIAL=White paper 88mm';;
  70160015) echo 'MATERIAL=Yellow plastic 88mm';;
  70160025) echo 'MATERIAL=Red plastic 88mm';;
  *) echo 'MATERIAL=UNKNOWN';;
esac
if (( $# == 2 ));then
  if [[ "$2" != "$sku" ]];then
    echo "SKU_CHECK=MISMATCH (expected $2)";exit 4
  else
    echo 'SKU_CHECK=MATCH'
  fi
fi
