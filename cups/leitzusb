#!/usr/bin/env bash
# CUPS backend - validated Leitz raster spool -> configured /dev/usb/lpN
# Material preflight via ESC U, exact VID/PID and SKU. No PDF converter.
set -euo pipefail
LC_ALL=C

# CUPS discovery: only advertise matching Leitz hardware, not arbitrary USB
# printer-class devices. No print data is sent during discovery.
if (($# == 0)); then
  for node in /sys/class/usbmisc/lp[0-9]*; do
    [[ -e "$node" ]] || continue
    port=${node##*/}
    [[ -c "/dev/usb/$port" ]] || continue
    base=$(readlink -f "$node/device") || continue
    base=${base%/*}
    [[ -r "$base/idVendor" && -r "$base/idProduct" ]] || continue
    read -r v < "$base/idVendor" || continue
    read -r p < "$base/idProduct" || continue
    if [[ "${v,,}" == 289e && "${p,,}" == 1000 ]]; then
      printf 'direct leitzusb:/dev/usb/%s?sku=auto "Leitz Icon" "Leitz Icon USB (%s)" "MFG:Leitz;MDL:Icon;"\n' "$port" "$port"
    fi
  done
  exit 0
fi

uri=${DEVICE_URI:-}
if [[ ! "$uri" =~ ^leitzusb:/dev/usb/(lp[0-9]+)(\?sku=(auto|[0-9]{8}))?$ ]]; then
  echo 'ERROR: DEVICE_URI must be leitzusb:/dev/usb/lpN?sku=auto or NNNNNNNN' >&2
  exit 4
fi
port=${BASH_REMATCH[1]}
expected=${BASH_REMATCH[3]:-auto}
usb_device="/dev/usb/$port"
if (( $# != 5 && $# != 6 )); then echo 'ERROR: invalid CUPS backend arguments' >&2;exit 4;fi
# The CUPS raster pipeline expands copies because cupsManualCopies is True.
# Replaying this byte stream at the backend would risk duplicate labels.
if [[ ! "$4" =~ ^[1-9][0-9]*$ ]]; then
  echo 'ERROR: Invalid CUPS copy count' >&2;exit 4
fi

# The backend, not the CUPS filter, accesses USB. CUPS should run it as root
# (backend mode 0700) inside a properly isolated CUPS container.
if [[ -z "${LEITZ_VALIDATE_BIN:-}" ]]; then LEITZ_VALIDATE_BIN=/usr/lib/cups/filter/leitz-cli;fi
[[ -x "$LEITZ_VALIDATE_BIN" ]] || { echo 'ERROR: leitz-cli validator not installed' >&2;exit 4; }

# Stage entire job and validate before touching USB. Disk-space failures are
# fatal; failed data must never reach the printer.
tmp=$(mktemp "${TMPDIR:-/tmp}/leitzjob.XXXXXXXX") || exit 4
trap 'rm -f -- "$tmp"' EXIT
if (($# == 6)); then cp -- "$6" "$tmp" || exit 4; else cat > "$tmp" || exit 4;fi
size=$(stat -c %s -- "$tmp")
# 64 pages of at most 64000 rows of 960 bits can exceed 25 MB.
# Match the bounded capacity of the modular backend.
max_job_bytes=$((544 * 1024 * 1024))
if ((size < 130 || size > max_job_bytes)); then
  echo "ERROR: Suspicious job length $size; not sent" >&2; exit 4
fi
"$LEITZ_VALIDATE_BIN" validate "$tmp" || { echo 'ERROR: Rejected invalid Leitz job' >&2;exit 4; }
# Inspect the width encoded in ESC w. This is part of the *validated* header,
# not arbitrary byte search. Header: 120 ESC preamble, 13-byte command prefix.
read -r width_hi width_lo < <(od -An -tu1 -j 133 -N 2 "$tmp")
job_width=$((width_hi*256+width_lo))
if ((job_width<1 || job_width>960));then
  echo "ERROR: Unsupported raster width $job_width" >&2; exit 4
fi
if ((size % 64 == 0)); then
  echo 'WARNING: USB job size divisible by 64; the link to earlier cut failures remains UNPROVEN' >&2
fi

root=$(readlink -f "/sys/class/usbmisc/$port/device") || exit 4
root=${root%/*}
read -r vid < "$root/idVendor" || exit 4
read -r pid < "$root/idProduct" || exit 4
if [[ "${vid,,}" != 289e || "${pid,,}" != 1000 ]]; then
  echo "ERROR: Wrong USB device: $vid:$pid" >&2;exit 4
fi
[[ -c "$usb_device" && ! -L "$usb_device" ]] || { echo 'ERROR: USB printer missing or not a direct device node' >&2; exit 4; }
exec 3<>"$usb_device" || { echo 'ERROR: Cannot access Leitz USB printer' >&2;exit 4; }
printf '\033U' >&3 || { echo 'ERROR: ESC U failed' >&2;exit 4; }
# ESC U replies need not contain NUL. A timeout may leave a complete
# response; only the strict full-message parser below may accept it.
response=''
IFS= read -r -d '' -n 1024 -t 5 response <&3 || :
[[ -n "$response" ]] || { echo 'ERROR: No cartridge response' >&2;exit 4; }
if [[ "$response" == 'SKU:No Cartridge;;;' ]]; then
  echo 'ERROR: No cartridge; job blocked' >&2;exit 4
fi
if [[ "$response" =~ ^SKU:([0-9]{8})\;INIT:([0-9]+)\;USED:([0-9]+)\;$ ]]; then
  actual_sku=${BASH_REMATCH[1]}
else
  echo 'ERROR: Unknown cartridge response; job blocked' >&2;exit 4
fi
# When the CUPS PageSize encodes a documented cassette SKU, compare it
# against the cartridge actually reported by the printer. For names without
# a provable cassette association retain the explicit DEVICE_URI check; a
# width-only match is not proof of matching label stock.
selected_sku=''
if [[ " $5 " =~ [[:space:]]PageSize=([[:alnum:]_]+)[[:space:]] ]]; then
  selected_media=${BASH_REMATCH[1]}
  if [[ "$selected_media" =~ ([0-9]{8})$ ]]; then
    selected_sku=${BASH_REMATCH[1]}
  fi
fi
if [[ -n "$selected_sku" && "$selected_sku" != "$actual_sku" ]]; then
  echo "ERROR: Selected PageSize requires cassette $selected_sku; detected $actual_sku" >&2
  exit 4
fi
if [[ "$expected" != auto && "$actual_sku" != "$expected" ]]; then
  echo "ERROR: Wrong cartridge; expected $expected, got $response" >&2;exit 4
fi
# Match known installed cartridge capacities to selected raster *width*.
# Widths other than 88mm are from vendor GPD catalog, not hardware tested.
# Smaller selections on wider continuous media are permitted; applications
# control positioning. Unknown cartridges require explicit SKU in DEVICE_URI.
case "$actual_sku" in
  70030001|70160015|70160025|70180001|70190001) physical_width=960 ;;
  70040001) physical_width=690 ;;
  70050001) physical_width=643 ;;
  70060001) physical_width=561 ;;
  70070001) physical_width=431 ;;
  70080001) physical_width=348 ;;
  70090001) physical_width=265 ;;
  70100001) physical_width=194 ;;
  70110001) physical_width=118 ;;
  70130001) physical_width=667 ;;
  *)
    echo "ERROR: Unknown cartridge SKU $actual_sku; physical print width not established. Job not sent." >&2
    exit 4
    ;;
esac
if ((job_width>physical_width)); then
  echo "ERROR: Selected print width $job_width pixels exceeds cartridge print width $physical_width pixels (SKU $actual_sku)" >&2
  exit 4
fi
# Check a confirmed ready reply on the same open descriptor immediately
# before sending. An unrecognized state must block delivery.
printf '\033A' >&3 || { echo 'ERROR: ESC A request failed' >&2; exit 4; }
IFS= read -r -N 1 -t 5 status_byte <&3 || {
  echo 'ERROR: Missing ESC A ready status; job not sent' >&2;exit 4;
}
[[ ${#status_byte} == 1 ]] || { echo 'ERROR: Empty ESC A reply' >&2; exit 4; }
printf -v status_code '%d' "'$status_byte"
if (( status_code != 3 )); then
  printf -v status_hex '0x%02X' "$status_code"
  echo "ERROR: Printer not ready: ESC A status $status_hex" >&2
  exit 4
fi
# Successful USB writes are not evidence of mechanical completion.
# Never automatically replay a possibly partly printed job.
if ! cat -- "$tmp" >&3; then echo 'ERROR: USB transfer failed; inspect device before retry' >&2;exit 4;fi
exec 3>&-
echo 'INFO: Leitz job transmitted (physical completion not confirmed)' >&2
exit 0
