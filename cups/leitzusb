#!/usr/bin/env bash
# CUPS backend - validated Leitz raster spool -> configured /dev/usb/lpN
# Material preflight via ESC U, exact VID/PID and SKU. No PDF converter.
set -euo pipefail
LC_ALL=C

# CUPS discovery: only advertise matching Leitz hardware, not arbitrary USB
# printer-class devices. No print data is sent during discovery.
if (($# == 0)); then
  for node in /sys/class/usbmisc/lp[0-9]*; do
    [[ -e "$node" ]] || continue
    port=${node##*/}
    [[ -c "/dev/usb/$port" ]] || continue
    base=$(readlink -f "$node/device") || continue
    base=${base%/*}
    [[ -r "$base/idVendor" && -r "$base/idProduct" ]] || continue
    read -r v < "$base/idVendor" || continue
    read -r p < "$base/idProduct" || continue
    if [[ "${v,,}" == 289e && "${p,,}" == 1000 ]]; then
      printf 'direct leitzusb:/dev/usb/%s?sku=auto "Leitz Icon" "Leitz Icon USB (%s)" "MFG:Leitz;MDL:Icon;"\n' "$port" "$port"
    fi
  done
  exit 0
fi

uri=${DEVICE_URI:-}
# CUPS discovery advertises sku=auto. Also accept older queue URIs
# without a query, so pre-existing queues remain usable after upgrade.
if [[ ! "$uri" =~ ^leitzusb:/dev/usb/(lp[0-9]+)(\?sku=(auto|[0-9]{8,9}))?$ ]]; then
  echo 'ERROR: DEVICE_URI must be leitzusb:/dev/usb/lpN[?sku=auto|NNNNNNNN]' >&2
  exit 4
fi
port=${BASH_REMATCH[1]}
expected=${BASH_REMATCH[3]:-auto}
usb_device="/dev/usb/$port"
if (( $# != 5 && $# != 6 )); then echo 'ERROR: invalid CUPS backend arguments' >&2;exit 4;fi
# CUPS' RIP expands manual copies upstream when cupsManualCopies is True.
# The spool arriving here already contains the final print sequence.
# Never replay the binary job: doing so could duplicate labels after a
# partially completed mechanical print.
if [[ ! "$4" =~ ^[1-9][0-9]*$ ]]; then
  echo 'ERROR: Invalid CUPS copy count' >&2;exit 4
fi

# The backend, not the CUPS filter, accesses USB. CUPS should run it as root
# (backend mode 0700) inside a properly isolated CUPS container.
if [[ -z "${LEITZ_VALIDATE_BIN:-}" ]]; then LEITZ_VALIDATE_BIN=/usr/lib/cups/filter/leitz-cli;fi
[[ -x "$LEITZ_VALIDATE_BIN" ]] || { echo 'ERROR: leitz-cli validator not installed' >&2;exit 4; }

# Stage entire job and validate before touching USB. Disk-space failures are
# fatal; failed data must never reach the printer.
tmp=$(mktemp "${TMPDIR:-/tmp}/leitzjob.XXXXXXXX") || exit 4
writer_pid=''
prn_file=''
cleanup() {
  # Cancellation must not leave an orphaned writer continuing to print
  # after CUPS has stopped the backend. Partial USB delivery is possible.
  if [[ -n "$writer_pid" ]]; then
    kill -TERM "$writer_pid" 2>/dev/null || :
  fi
  rm -f -- "$tmp"
  if [[ -n "$prn_file" ]]; then rm -f -- "$prn_file"; fi
}
on_cancel() {
  echo 'ERROR: USB transfer cancelled; output may be incomplete. Inspect printer before resubmission.' >&2
  # CUPS_BACKEND_CANCEL=5: do not retry a possibly partly printed job.
  # CUPS_BACKEND_FAILED=1 would delegate retry behavior to error-policy.
  exit 5
}
trap cleanup EXIT
trap on_cancel TERM INT HUP
if (($# == 6)); then cp -- "$6" "$tmp" || exit 4; else cat > "$tmp" || exit 4;fi
size=$(stat -c %s -- "$tmp")
# The only maintenance frame is produced by cups/leitz-command and
# issues ESC A without raster bytes, a feed, a cut, or an automatic retry.
control_request=0
control_kind=''
if cmp -s "$tmp" <(printf 'LEITZ-CMD-V1:REPORT_STATUS\n'); then
  control_request=1;control_kind=status
elif cmp -s "$tmp" <(printf 'LEITZ-CMD-V1:GET_FIRMWARE_VERSION\n'); then
  control_request=1;control_kind=firmware
elif cmp -s "$tmp" <(printf 'LEITZ-CMD-V1:GET_WIFI_STATE\n'); then
  control_request=1;control_kind=wifi
fi
# The raster filter supports up to 64 pages, each with up to 64000
# rows of 960 pixels. A valid multi-page job can exceed 25 MB by far.
# Both encoders have a worst-case payload below 544 MiB for 64 pages.
max_job_bytes=$((544 * 1024 * 1024))
if (( ! control_request && (size < 130 || size > max_job_bytes) )); then
  echo "ERROR: Suspicious job length $size; not sent" >&2; exit 4
fi
if (( ! control_request )); then
# Independently validate the full spool through installed protocol modules.
# Reject unrecognised framing and mixed media widths before opening USB.
width_info=$("$LEITZ_VALIDATE_BIN" validate-auto "$tmp") || {
  echo 'ERROR: No installed protocol accepts the print job' >&2; exit 4;
}
# The backend is protocol-independent. Installed validators verify the
# entire job before USB opens; only the validated print width is needed.
if [[ "$width_info" =~ ^MAX_WIDTH=([0-9]+)$ ]]; then
  job_width=${BASH_REMATCH[1]}
else
  echo 'ERROR: Validator returned no unambiguous print width' >&2
  exit 4
fi
if ((job_width<1 || job_width>960));then
  echo "ERROR: Unsupported raster width $job_width" >&2; exit 4
fi
fi # Printer maintenance does not require a raster header or loaded media.
root=$(readlink -f "/sys/class/usbmisc/$port/device") || exit 4
root=${root%/*}
read -r vid < "$root/idVendor" || exit 4
read -r pid < "$root/idProduct" || exit 4
if [[ "${vid,,}" != 289e || "${pid,,}" != 1000 ]]; then
  echo "ERROR: Wrong USB device: $vid:$pid" >&2;exit 4
fi
# Never let a mutable lpN symlink redirect an already identified port
# to another character device between sysfs validation and open.
[[ -c "$usb_device" && ! -L "$usb_device" ]] || {
  echo 'ERROR: USB printer missing or not a direct device node' >&2; exit 4;
}
exec 3<>"$usb_device" || { echo 'ERROR: Cannot open Leitz USB printer (busy or inaccessible)' >&2;exit 4; }
if (( control_request )); then
  # These frames are read-only and source-backed:
  # validate_reception.py: ESC A=status, ESC V=firmware, ESC u 00=WiFi state.
  # Do not expose its ESC W boot-mode or WiFi-writing commands.
  if [[ "$control_kind" != status ]]; then
    if [[ "$control_kind" == firmware ]]; then
      printf '\033V' >&3 || exit 4
    else
      printf '\033u\000' >&3 || exit 4
    fi
    data=''
    IFS= read -r -d '' -n 64 -t 5 data <&3 || :
    if [[ -z "$data" || ! "$data" =~ ^[[:print:]]+$ ]]; then
      echo "ERROR: Invalid or absent Leitz $control_kind reply" >&2
      exit 4
    fi
    echo "INFO: Leitz $control_kind reply: $data" >&2
    exec 3>&-
    exit 0
  fi
  printf '\033A' >&3 || { echo 'ERROR: CUPS ReportStatus ESC A request failed' >&2;exit 4; }
  IFS= read -r -N 1 -t 5 status_byte <&3 || {
    echo 'ERROR: CUPS ReportStatus returned no status byte' >&2;exit 4;
  }
  [[ ${#status_byte} == 1 ]] || { echo 'ERROR: Invalid ESC A status response' >&2;exit 4; }
  printf -v status_code '%d' "'$status_byte"
  printf -v status_hex '0x%02X' "$status_code"
  case "$status_code" in
    3) echo 'STATE: -media-empty -media-jam' >&2
       echo 'INFO: Leitz ESC A status 0x03 (ready)' >&2 ;;
    32) echo 'STATE: +media-empty' >&2
        echo "WARNING: Leitz ESC A legacy media-empty ($status_hex)" >&2 ;;
    48) echo 'STATE: +media-jam' >&2
        echo "WARNING: Leitz ESC A legacy paper-jam ($status_hex)" >&2 ;;
    64) echo "WARNING: Leitz ESC A legacy general error ($status_hex)" >&2 ;;
    *) echo "WARNING: Leitz ESC A status $status_hex is not decoded; no printer-ready claim" >&2 ;;
  esac
  exec 3>&-
  exit 0
fi
printf '\033U' >&3 || { echo 'ERROR: ESC U failed' >&2;exit 4; }
# Cartridge replies may end without a NUL byte. Bash can return timeout
# with a complete partial buffer; accept it ONLY if the strict SKU parser
# below validates the entire response. Incomplete replies remain fatal.
response=''
IFS= read -r -d '' -n 1024 -t 5 response <&3 || :
if [[ -z "$response" ]]; then
  echo 'ERROR: No cartridge response' >&2;exit 4
fi
if [[ "$response" == 'SKU:No Cartridge;;;' ]]; then
  echo 'STATE: +media-empty +com.leitz.no-cartridge-error' >&2
  echo 'ERROR: No cartridge; job blocked' >&2;exit 4
fi
if [[ "$response" =~ ^SKU:([0-9]{8,9})\;INIT:([0-9]+)\;USED:([0-9]+)\;$ ]]; then
  actual_sku=${BASH_REMATCH[1]}
else
  echo 'ERROR: Unknown cartridge response; job blocked' >&2;exit 4
fi
echo 'STATE: -media-empty -com.leitz.no-cartridge-error' >&2
if [[ "$expected" != auto && "$actual_sku" != "$expected" ]]; then
  echo 'STATE: +com.leitz.incompatible-cartridge-error' >&2
  echo "ERROR: Wrong cartridge; expected $expected, got $response" >&2;exit 4
fi
# The macOS PaperCatalog.plist lists multiple compatible cartridges for
# many PageSize choices. This is a source-backed whitelist, NOT an SKU
# extracted from a page-name suffix. New/unlisted vendor media remain
# subject to the separate physical printable-width check below.
selected_media=''
if [[ " $5 " =~ [[:space:]]PageSize=([[:alnum:]_]+)[[:space:]] ]]; then
  selected_media=${BASH_REMATCH[1]}
  # A/B profile aliases share vendor geometry but not all vendor options.
  # The original macOS ID LeitzLeverArchFile1005 already begins with
  # Leitz; only strip our additional B-profile prefix from other names.
  if [[ "$selected_media" == Leitz* && "$selected_media" != LeitzLeverArchFile1005 ]]; then
    selected_media=${selected_media#Leitz}
  fi
fi
allowed_skus=''
# BEGIN GENERATED SOURCE: macOS PaperCatalog.plist CompatibleSKUs
case "$selected_media" in
  DHLShippingLabel) allowed_skus=' 70270001 70030001 170030001 70160001 70160015 70160025 70190001 ' ;;
  LeitzLeverArchFile1005) allowed_skus=' 70060001 ' ;;
  AppointmentCard) allowed_skus=' 70270001 70190001 70030001 170030001 70160001 70160015 70160025 ' ;;
  Continuous112) allowed_skus=' 70070001 ' ;;
  Continuous70030001) allowed_skus=' 70270001 70030001 170030001 70160001 70160015 70160025 70190001 ' ;;
  Continuous70040001) allowed_skus=' 70040001 ' ;;
  Continuous70050001) allowed_skus=' 70050001 ' ;;
  Continuous70060001) allowed_skus=' 70060001 ' ;;
  Continuous70080001) allowed_skus=' 70080001 ' ;;
  Continuous70090001) allowed_skus=' 70090001 ' ;;
  Continuous70100001) allowed_skus=' 70100001 ' ;;
  Continuous70110001) allowed_skus=' 70110001 70150001 70150015 70150025 ' ;;
  Continuous70190001) allowed_skus=' 70270001 70190001 70030001 170030001 70160001 70160015 70160025 ' ;;
  FileFolderLabel) allowed_skus=' 70110001 70150001 70150015 70150025 ' ;;
  InternationalAddressLabel) allowed_skus=' 70270001 70120001 70030001 170030001 70160001 70160015 70160025 70190001 ' ;;
  LargePendaflexTab) allowed_skus=' 70060001 70080001 ' ;;
  Multipurpose70030001) allowed_skus=' 70270001 70180001 70030001 170030001 70060001 70160001 70160015 70160025 70190001 ' ;;
  Multipurpose70090001) allowed_skus=' 70090001 ' ;;
  Multipurpose70100001) allowed_skus=' 70100001 ' ;;
  Multipurpose70110001) allowed_skus=' 70110001 70150001 70150015 70150025 ' ;;
  NameBadgeCard70190001) allowed_skus=' 70270001 70190001 70030001 170030001 70160001 70160015 70160025 70050001 ' ;;
  NameBadgeCard8214) allowed_skus=' 70270001 70190001 70030001 170030001 70160001 70160015 70160025 ' ;;
esac
# END GENERATED SOURCE
if [[ -n "$allowed_skus" && "$allowed_skus" != *" $actual_sku "* ]]; then
  echo 'STATE: +com.leitz.incompatible-cartridge-error' >&2
  echo "ERROR: Cassette $actual_sku is not listed as compatible with PageSize $selected_media by macOS PaperCatalog" >&2
  exit 4
fi

# macOS CartridgesCatalog.plist classifies roll versus die-cut cassettes.
# Auto is necessary: the original YES default cannot correctly describe
# every installed cassette, especially continuous rolls. Explicit YES/NO
# are strictly verified if the catalog proves the material kind.
case "$actual_sku" in
  70030001|70270001|170030001|70040001|70050001|70060001|70070001|70080001|70090001|70100001|70110001|70150001|70150015|70150025|70160001|70160015|70160025|70190001) media_kind=continuous ;;
  70120001|70130001|70170001|70180001|70280001) media_kind=diecut ;;
  *) media_kind=unknown ;;
esac
if [[ " $5 " == *"IsCurrentInsertedCartridgeDieCut=YES"* && "$media_kind" == continuous ]] ||
   [[ " $5 " == *"IsCurrentInsertedCartridgeDieCut=NO"* && "$media_kind" == diecut ]]; then
  echo 'STATE: +com.leitz.incompatible-cartridge-error' >&2
  echo "ERROR: Explicit die-cut setting disagrees with macOS catalog for cassette $actual_sku" >&2
  exit 4
fi
echo 'STATE: -com.leitz.incompatible-cartridge-error' >&2
# Match known installed cartridge capacities to selected raster *width*.
# Widths other than 88mm are from vendor GPD catalog, not hardware tested.
# Smaller selections on wider continuous media are permitted; applications
# control positioning. An explicitly selected SKU proves identity, NOT width.
# Never assume 960 pixels for a cartridge with unknown geometry.
case "$actual_sku" in
  70030001|70270001|170030001|70160001|70160015|70160025|70180001|70190001) physical_width=960 ;;
  70040001) physical_width=690 ;;
  70050001) physical_width=643 ;;
  70060001) physical_width=561 ;;
  70070001) physical_width=431 ;;
  70080001) physical_width=348 ;;
  70090001) physical_width=265 ;;
  70100001) physical_width=194 ;;
  70110001|70150001|70150015|70150025) physical_width=118 ;;
  70130001) physical_width=667 ;;
  *)
    echo "ERROR: Unknown cartridge SKU $actual_sku; physical print width not established. Job not sent." >&2
    exit 4
    ;;
esac
if ((job_width>physical_width)); then
  echo "ERROR: Maximum job print width $job_width pixels exceeds cartridge print width $physical_width pixels (SKU $actual_sku)" >&2
  exit 4
fi
# Hardware-proven ESC A reply 0x03 means READY in both original macOS
# decoders. Query *after* validating the job and matching the cartridge,
# on the same exclusive /dev/usb/lpN descriptor. Never treat unknown
# status bytes as ready and never initiate automatic job replay.
# Original Linux ShouldSend_ESC_A is a selectable print-job option. YES
# remains the safest default; NO bypasses only ESC A, never the strict SKU,
# width, spool, or USB identity checks above.
if [[ " $5 " != *"ShouldSend_ESC_A=NO"* ]]; then
  printf '\033A' >&3 || { echo 'ERROR: ESC A request failed' >&2; exit 4; }
  IFS= read -r -N 1 -t 5 status_byte <&3 || {
    echo 'ERROR: No one-byte ESC A status reply; job not sent' >&2; exit 4;
  }
  printf -v status_code '%d' "'$status_byte"
  if (( status_code != 3 )); then
    printf -v status_hex '0x%02X' "$status_code"
    echo "ERROR: Printer not ready: ESC A status $status_hex; job not sent" >&2
    exit 4
  fi
else
  echo 'WARNING: ESC A readiness check bypassed by explicit CUPS option' >&2
fi
# A successful write means that the kernel accepted bytes, not necessarily
# that all labels finished printing. Cancellation terminates the writer;
# the resulting partial delivery must NEVER be automatically replayed.
# Original Linux PrintThroughPRN=ON sends the staged .prn file to USB.
# This validated replay-free route is intentionally opt-in, and its temporary
# file is deleted with the regular backend spool on every exit.
print_file=$tmp
if [[ " $5 " == *"PrintThroughPRN=ON"* ]]; then
  prn_file=$(mktemp "${TMPDIR:-/tmp}/leitzjob.XXXXXXXX.prn") || exit 4
  cp -- "$tmp" "$prn_file" || exit 4
  cmp -s -- "$tmp" "$prn_file" || { echo 'ERROR: PRN copy mismatch' >&2; exit 4; }
  print_file=$prn_file
  echo 'INFO: Sending validated print job through temporary .prn spool' >&2
fi
if [[ " $5 " == *"DebugMode=Debug"* ]]; then
  echo "DEBUG: print size=$size, cartridge=$actual_sku, width=$job_width, device=$usb_device" >&2
fi
cat -- "$print_file" >&3 &
writer_pid=$!
if wait "$writer_pid"; then
  writer_pid=''
else
  writer_pid=''
  echo 'ERROR: USB transfer failed or interrupted; print status unknown. Inspect printer before resubmission.' >&2
  exit 4
fi
exec 3>&-
echo 'INFO: Leitz job transferred to USB; mechanical completion unverified' >&2
exit 0
