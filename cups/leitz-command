#!/usr/bin/env bash
# CUPS command-file filter. Strictly support ReportStatus, never emit
# print/cut protocol commands. The exclusive USB backend performs ESC A.
set -euo pipefail
LC_ALL=C
if (( $# != 5 && $# != 6 )); then
  echo 'ERROR: Invalid CUPS command-filter arguments' >&2
  exit 1
fi
tmp=$(mktemp "${TMPDIR:-/tmp}/leitz-command.XXXXXXXX") || exit 1
trap 'rm -f -- "$tmp"' EXIT
# Bound both named-file and stdin input before parsing. A CUPS maintenance
# request must never be a megabyte-scale replacement raster payload.
if (( $# == 6 )); then
  head -c 8193 -- "$6" > "$tmp"
else
  head -c 8193 > "$tmp"
fi
size=$(stat -c %s -- "$tmp")
if (( size < 15 || size > 8192 )); then
  echo 'ERROR: Invalid CUPS command-file size' >&2
  exit 1
fi
first=1
found=0
request=''
shopt -s nocasematch
while IFS= read -r line || [[ -n "$line" ]]; do
  line=${line%$'\r'}
  if (( first )); then
    first=0
    if [[ "$line" != '#CUPS-COMMAND' ]]; then
      echo 'ERROR: Missing CUPS command-file signature' >&2
      exit 1
    fi
    continue
  fi
  if [[ "$line" =~ ^[[:space:]]*$ || "${line:0:1}" == '#' ]]; then
    continue
  fi
  command=''
  argument=''
  read -r command argument <<< "$line"
  case "$command" in
    ReportStatus|GetPrinterStatus) command=ReportStatus ;;
    GetFirmwareVersion) ;;
    *) echo 'ERROR: Unsupported Leitz CUPS maintenance command' >&2; exit 1 ;;
  esac
  if [[ -n "$argument" || ( -n "$request" && "$request" != "$command" ) ]]; then
    echo 'ERROR: Mixed or parameterized Leitz commands are not supported' >&2
    exit 1
  fi
  request=$command
  found=1
done < "$tmp"
if (( ! found )); then
  echo 'ERROR: Empty Leitz CUPS maintenance request' >&2
  exit 1
fi
# Exact internal frame, recognized only by our USB backend. No device bytes
# are transmitted by this filter. Multiple identical queries are coalesced.
case "$request" in
  ReportStatus) printf 'LEITZ-CMD-V1:REPORT_STATUS\n' ;;
  GetFirmwareVersion) printf 'LEITZ-CMD-V1:GET_FIRMWARE_VERSION\n' ;;
esac
